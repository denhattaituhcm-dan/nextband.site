{
  "name": "nextband-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:be\" \"npm run dev:fe\"",
    "dev:fe": "vite --config nextband/vite.config.ts",
    "dev:be": "tsx watch server/index.ts",
    "build": "node scripts/build.mjs",
    "build:api": "node scripts/bundle-api.mjs",
    "build:fe": "vite build --config nextband/vite.config.ts",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p nextband/tsconfig.app.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.19.1",
    "@supabase/supabase-js": "^2.91.1",
    "@tailwindcss/typography": "^0.5.16",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "esbuild": "^0.21.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "google-auth-library": "^10.5.0",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.5",
    "postcss": "^8.5.6",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3"
  }
}
