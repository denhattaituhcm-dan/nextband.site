{
  "buildCommand": "npm run build",
  "outputDirectory": "nextband/dist",
  "regions": ["syd1"],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{node_modules/.prisma/client/**,prisma/**}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/weekly-snapshot",
      "schedule": "15 11 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/health",
      "destination": "/api/v1/health.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|assets|favicon|logo|Logo|uploads).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
