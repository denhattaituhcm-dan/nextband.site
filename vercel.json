{
  "buildCommand": "npm run build",
  "outputDirectory": "nextband/dist",
  "regions": ["syd1"],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{node_modules/.prisma/client/**,nextband/node_modules/.prisma/client/**,prisma/**,nextband/prisma/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/health",
      "destination": "/api/v1/health.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|assets|favicon|Logo).*)",
      "destination": "/index.html"
    }
  ]
}
