# Environment
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL / Direct or Connection Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# File Storage (Local VPS)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# Frontend URL (for CORS)
FRONTEND_URL=http://nextband.site
APP_URL=http://localhost:3000