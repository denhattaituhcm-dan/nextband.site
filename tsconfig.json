{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["server/*"],
      "@/*": ["nextband/src/*"]
    }
  },
  "include": ["server/**/*", "scripts/**/*", "api/**/*"],
  "exclude": ["node_modules", "dist", "nextband/dist", "ielts-api", "scripts/archive"]
}
