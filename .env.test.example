# ==============================================================================
# NEXTBAND — DEDICATED TEST ENVIRONMENT CONFIGURATION (.env.test)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.test or .env.test.local
# 2. Configure a local PostgreSQL instance or a dedicated testing Supabase project
# 3. NEVER, UNDER ANY CIRCUMSTANCES, POINT THESE VARIABLES TO PRODUCTION SUPABASE!
#
# SRE Guard P0 Denylist Hostnames:
# - aws-0-ap-southeast-2.pooler.supabase.com
# - gzpdlqxjggyxlkeatvvf
#
# Recommended Local Test Database:
# docker run --name nextband-test-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=nextband_test -p 5433:5432 -d postgres:16-alpine
# ==============================================================================

NODE_ENV=test
VITEST=true

# Dedicated Test Database URLs (Must NOT match production hostnames)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/nextband_test?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nextband_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/nextband_test?schema=public"

# Test JWT Secrets
JWT_SECRET="test_jwt_secret_min_32_characters_for_isolated_testing_only"
JWT_EXPIRES_IN="1d"

# Test Supabase Mock/Local URL
SUPABASE_URL="http://localhost:54321"
SUPABASE_SERVICE_ROLE_KEY="test_service_role_key_mock_only"
